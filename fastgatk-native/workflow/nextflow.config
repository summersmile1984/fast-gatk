/*
 * Scheduler profile for the GATK-compatible workflow.
 *
 * Default execution is local so the contract can be tested on a workstation.
 * Use `-profile slurm` on a real cluster; Nextflow then owns sbatch/squeue
 * submission and the native process only consumes the allocation exported by
 * SLURM.  The process scripts still call slurm_smoke.sh, which detects an
 * existing allocation and does not submit a nested job.
 */

params {
    executor = 'local'
    slurm_queue = null
    slurm_cluster_options = null
    // Optional container image.  The launcher remains the same inside the
    // container; enable the corresponding Nextflow engine with -with-docker,
    // -with-singularity, or the site-specific container profile.
    container = null
    // A non-zero value is translated to a scheduler GPU request by the
    // slurm_gpu profile.  Kokkos device execution is still a build/runtime
    // capability and is never inferred from this request alone.
    gpu_count = 0
    gpu_type = null
    cpus = 2
    memory = '4 GB'
}

process {
    executor = params.executor ?: 'local'
    queue = params.slurm_queue ?: null
    clusterOptions = params.slurm_cluster_options ?: null
    cpus = params.cpus as int
    memory = params.memory ?: null
    container = params.container ?: null
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_queue ?: null
        process.clusterOptions = params.slurm_cluster_options ?: null
    }
    // Use this profile when the cluster's SLURM integration expects an
    // explicit --gpus request.  A caller-provided clusterOptions string wins,
    // so site-specific --gres/--constraint flags remain available.
    slurm_gpu {
        process.executor = 'slurm'
        process.queue = params.slurm_queue ?: null
        process.clusterOptions = params.slurm_cluster_options ?: (
            params.gpu_count > 0 ? "--gpus=${params.gpu_count}${params.gpu_type ? ':' + params.gpu_type : ''}" : null
        )
    }
}
